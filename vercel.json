{
  "version": 2,
  "buildCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "server.js": {
      "runtime": "@vercel/node@3.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
